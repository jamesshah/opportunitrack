# Edge Function secrets. Copy to .env and run: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase and must not be set here.

# Optional: defaults to ${SUPABASE_URL}/functions/v1
PUBLIC_FUNCTIONS_URL=
APP_REDIRECT_URL=tech.jamesshah.OpportuniTrack://oauth-callback

# Google (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=projects/<gcp-project>/topics/gmail-push
GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push-invoker@<gcp-project>.iam.gserviceaccount.com
# Optional: defaults to the gmail-webhook URL
GMAIL_PUSH_AUDIENCE=

# Microsoft (Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Classifier: systemone (TypeSafe AI) or heuristic
CLASSIFIER_PROVIDER=systemone
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
JOB_THRESHOLD=0.6

# Sync
BACKFILL_DAYS=30
BACKFILL_MAX_MESSAGES=300
PREFILTER_ENABLED=true

# APNs (token auth, .p8 key contents with \n for newlines)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tech.jamesshah.OpportuniTrack
